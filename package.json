{
  "name": "@vidoxlabs/lattice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Vidoxlabs website: Vivarium, its systems, live status and docs.",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "content:build": "node scripts/build-content.mjs",
    "snapshot:refresh": "node scripts/snapshot-refresh.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "videsign:sync": "node scripts/sync-videsign.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:routes": "node --test tests/routes/*.test.mjs",
    "test:browser": "playwright install chromium webkit && node scripts/browser-check.mjs",
    "scan": "node scripts/scrub-scan.mjs .",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "ajv": "8.17.1",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@vidoxlabs/videsign": "github:Vidoxlabs/videsign#08707d61780ab2c873ac51cbfd39f2b29abfce9a",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "wrangler": "4.168.0"
  }
}
