{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "src/**/*.mjs", "scripts/**/*.js", "scripts/**/*.mjs", "tests/**/*.js", "tests/**/*.mjs", "astro.config.mjs", "playwright.config.mjs"]
}
