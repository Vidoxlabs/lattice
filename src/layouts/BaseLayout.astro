---
import LayoutPublicSite from '../components/videsign/layout-public-site.astro';
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/diagrams.css';
import '../styles/docs.css';
import pipeline from '../data/generated/build-pipeline.json' with { type: 'json' };
const { title, description = 'Vivarium, its systems, live status and docs.', currentPath = Astro.url.pathname } = Astro.props;
---
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/brand/brand_mark_header_v008.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <LayoutPublicSite currentPath={currentPath}>
      {pipeline.snapshot.used && <aside aria-label="Offline content notice">Showing committed snapshot data captured at {pipeline.snapshot.capturedAt ?? 'an unknown time'}.</aside>}
      <slot />
    </LayoutPublicSite>
    <script src="../scripts/theme.mjs"></script>
    <script src="../scripts/status-refresh.mjs"></script>
  </body>
</html>
