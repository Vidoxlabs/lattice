---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatDock from '../components/videsign/chat-dock.astro';
---
<BaseLayout title="Chat | Vidoxlabs" description="Ask grounded questions about Vivarium and its public documentation." chatPage>
  <h1>Ask about Vivarium</h1>
  <p class="lattice-prose">The chat answers from the verified documentation corpus and the gathered public repository status. When retrieval finds nothing, it says so instead of guessing, and every answer carries its citations.</p>
  <div class="lattice-chat-page" data-chat-page>
    <ChatDock surface="page" />
  </div>
</BaseLayout>
