---
import { monoLabelClasses } from '../../lib/ui-classes.mjs';
import { dateLabel } from '../../lib/dates.mjs';
const { items = [], title = 'Repository metrics', updated = '', statusRepository = '', statusUpdated = '' } = Astro.props;
---
<section data-videsign="kpi-metric-strip" aria-labelledby="kpi-strip-title" data-status-repository={statusRepository || undefined} class="flex flex-col gap-rhythm-4-base">
  <div class="flex flex-wrap items-baseline justify-between gap-gap-compact-default">
    <h2 id="kpi-strip-title" class={monoLabelClasses}>{title}</h2>
    <p class="flex flex-wrap items-baseline gap-gap-comfortable-default">
      {statusRepository && <span class={`${monoLabelClasses} tabular-nums`} data-status-source>{statusUpdated ? `Build data from ${dateLabel(statusUpdated)}` : 'Live data unavailable'}</span>}
      {updated && <span class={`${monoLabelClasses} tabular-nums`}>{updated}</span>}
    </p>
  </div>
  <dl class="grid grid-cols-1 gap-rhythm-4-base sm:grid-cols-2 lg:grid-cols-4">
    {items.map((item) => <div class="flex flex-col gap-gap-compact-default rounded-layout-radius-standard-base border border-border-separator-primary-base bg-surface-background-secondary-base p-layout-padding-large-base">
      <dt class={monoLabelClasses}>{item.label}</dt>
      <dd data-status-field={item.field || undefined} class="break-words font-typography-family-sans-base text-typography-size-3xl-base font-typography-weight-semibold-base tracking-typography-tracking-tight-base tabular-nums text-text-content-primary-base">{item.value}</dd>
      {item.note && <dd class="inline-flex items-center gap-gap-compact-default font-typography-family-mono-base text-typography-size-xs-base text-text-content-secondary-base"><span aria-hidden="true" class="h-indicator-dot-base w-indicator-dot-base shrink-0 rounded-layout-radius-full-base bg-status-indicator-info-base"></span><span>{item.note}</span></dd>}
    </div>)}
  </dl>
</section>
