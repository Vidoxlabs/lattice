---
import '../../styles/videsign/vi-orbital-hero.css';
// Ported from the videsign vi-orbital-field specimen: a quiet, pausable
// canvas hero surface. The engine honours prefers-reduced-motion, the
// document data-motion toggle and the light theme by itself.
const { eyebrow = 'Vivarium', heading = 'The page is still loading its own evidence' } = Astro.props;
---
<vi-orbital-field class="vi-orbital-host" data-videsign="vi-orbital-field" data-agent-state="start">
  <div class="lattice-orbital-copy">
    <p class="lattice-eyebrow">{eyebrow}</p>
    <h1 class="lattice-orbital-heading">{heading}</h1>
    <p class="lattice-prose">Every number on this site is generated from synced sources at build time, never typed by hand. The field pauses under reduced motion and resumes only when allowed.</p>
    <slot />
  </div>
</vi-orbital-field>
<script is:inline type="module" src="/videsign/vi-orbital-field.js"></script>
