---
const { currentPath = '/' } = Astro.props;
const links = [
  ['Vivarium', '/vivarium'],
  ['Repositories', '/repositories'],
  ['Docs', '/docs'],
  ['About', '/about'],
  ['Chat', '/chat'],
  ['Security', '/security']
];
---
<div id="site-nav-sheet" class="fixed inset-0 z-30 bg-surface-background-primary-base/80 p-rhythm-4-base backdrop-blur-sm" data-videsign="mobile-navigation-sheet" hidden>
  <div role="dialog" aria-modal="true" aria-labelledby="mobile-nav-title" class="mx-auto flex max-h-full max-w-md flex-col overflow-hidden rounded-layout-radius-standard-base border border-border-separator-primary-base bg-surface-background-secondary-base">
    <div class="flex items-center justify-between gap-gap-compact-default border-b border-border-separator-primary-base px-layout-padding-medium-base py-rhythm-2-base">
      <h2 id="mobile-nav-title" class="font-typography-family-mono-base text-typography-size-xs-base tracking-typography-tracking-wide-base text-text-content-secondary-base">Site navigation</h2>
      <button type="button" aria-label="Close navigation" class="inline-flex min-h-action-min-default items-center rounded-layout-radius-control-base border border-border-separator-primary-base px-rhythm-3-base font-typography-family-mono-base text-typography-size-xs-base text-text-content-primary-base" data-menu-close>Close</button>
    </div>
    <nav aria-label="Mobile primary navigation" class="flex-1 overflow-y-auto px-layout-padding-small-base py-rhythm-2-base">
      <ul class="flex flex-col gap-gap-dense-default">
        {links.map(([label, href]) => {
          const current = currentPath === href || currentPath.startsWith(`${href}/`);
          return <li><a href={href} aria-current={current ? 'page' : undefined} class={`flex min-h-action-min-default w-full items-center justify-between rounded-layout-radius-control-base px-inset-compact-default font-typography-family-sans-base text-typography-size-md-base ${current ? 'bg-surface-background-tertiary-base text-text-content-primary-base' : 'text-text-content-secondary-base hover:bg-surface-background-tertiary-base hover:text-text-content-primary-base'}`}><span>{label}</span><span aria-hidden="true">→</span></a></li>;
        })}
      </ul>
    </nav>
    <div class="border-t border-border-separator-primary-base px-layout-padding-medium-base py-rhythm-3-base">
      <p class="font-typography-family-sans-base text-typography-size-sm-base text-text-content-secondary-base">Vivarium, its systems, evidence and documentation.</p>
    </div>
  </div>
</div>
