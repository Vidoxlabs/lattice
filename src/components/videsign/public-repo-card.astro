---
import ClaimMaturityBadge from './claim-maturity-badge.astro';
import { buttonClasses, monoLabelClasses } from '../../lib/ui-classes.mjs';
import { dateLabel } from '../../lib/dates.mjs';
const { repository } = Astro.props;
const freshness = repository.status.docsFreshness.fresh === null ? 'Freshness unknown' : repository.status.docsFreshness.fresh ? 'Current' : 'Sync pending';
---
<article data-videsign="public-repo-card" data-repository-kind={repository.kind} data-repository-search={`${repository.name} ${repository.kind} ${repository.summary}`.toLowerCase()} class="flex h-full flex-col justify-between gap-gap-comfortable-default rounded-layout-radius-standard-base border border-border-separator-primary-base bg-surface-background-secondary-base p-layout-padding-large-base">
  <div class="flex flex-col gap-gap-compact-default">
    <div class="flex flex-wrap items-center justify-between gap-gap-compact-default">
      <span class={monoLabelClasses}>{repository.kind}</span>
      <ClaimMaturityBadge label={repository.claim} />
    </div>
    <h3 class="font-typography-family-sans-base text-typography-size-xl-base font-typography-weight-semibold-base tracking-typography-tracking-tight-base text-text-content-primary-base text-balance"><a href={`/repositories/${repository.name}`} class="inline-flex min-h-action-min-default items-center hover:underline">{repository.name}</a></h3>
    <p class="font-typography-family-sans-base text-typography-size-sm-base leading-typography-leading-normal-base text-text-content-secondary-base text-pretty">{repository.summary || 'Documentation has not synced yet.'}</p>
  </div>
  <div class="flex flex-col gap-gap-comfortable-default">
    <dl class="border-t border-border-separator-primary-base" data-status-repository={repository.name}>
      {[['CI', repository.status.ciConclusion, 'ci'], ['Docs', freshness, ''], ['Open PRs', repository.status.openPrCount ?? 'Unknown', 'openPrCount'], ['Test totals', repository.status.testTotals, '']].map(([label, value, field]) => <div class="flex items-baseline justify-between gap-gap-comfortable-default border-b border-border-separator-primary-base py-rhythm-2-base">
        <dt class={monoLabelClasses}>{label}</dt>
        <dd data-status-field={field || undefined} data-ci={field === 'ci' ? value : undefined} class="text-end font-typography-family-mono-base text-typography-size-xs-base tabular-nums text-text-content-primary-base">{value}</dd>
      </div>)}
    </dl>
    <p class={`${monoLabelClasses} tabular-nums`} data-status-source>{repository.buildAt ? `Build data from ${dateLabel(repository.buildAt)}` : 'Live data unavailable'}</p>
    <a href={`https://github.com/Vidoxlabs/${repository.name}`} class={buttonClasses.secondary}>Repository and evidence<span aria-hidden="true">→</span></a>
  </div>
</article>
