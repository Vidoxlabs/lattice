---
const { currentPath = '/' } = Astro.props;
const links = [
  ['Vivarium', '/vivarium'],
  ['Repositories', '/repositories'],
  ['Docs', '/docs'],
  ['About', '/about']
];
const linkClass = 'inline-flex min-h-action-min-default items-center whitespace-nowrap rounded-layout-radius-full-base px-inset-operator-default font-typography-family-mono-base text-typography-size-xs-base text-text-content-secondary-base transition-colors duration-transition-duration-fast-base ease-transition-easing-standard-base hover:text-text-content-primary-base';
---
<header data-videsign="site-header-island" class="sticky top-0 z-20 px-inset-compact-default py-rhythm-3-base sm:px-layout-padding-medium-base">
  <div class="vi-glass-shell vi-glass-shell--pill mx-auto max-w-7xl">
    <nav aria-label="Primary navigation" class="vi-glass-core vi-glass-core--pill flex min-w-0 items-center justify-between gap-gap-compact-default px-rhythm-2-base py-rhythm-1-base">
      <a href="/" class="inline-flex min-w-0 items-center gap-gap-compact-default rounded-layout-radius-full-base px-rhythm-2-base font-typography-family-sans-base text-typography-size-md-base font-typography-weight-semibold-base tracking-typography-tracking-tight-base text-text-content-primary-base sm:px-rhythm-3-base" aria-label="Vidoxlabs home">
        <img src="/brand/brand_mark_header_v008.svg" alt="" class="h-icon-sm-base w-icon-sm-base shrink-0" />
        <span>Vidoxlabs</span>
      </a>
      <ul class="hidden items-center gap-gap-dense-default lg:flex">
        {links.map(([label, href]) => {
          const current = currentPath === href || currentPath.startsWith(`${href}/`);
          return <li><a href={href} aria-current={current ? 'page' : undefined} class={`${linkClass} ${current ? 'bg-surface-background-tertiary-base text-text-content-primary-base' : ''}`}>{label}</a></li>;
        })}
      </ul>
      <div class="flex shrink-0 items-center gap-gap-dense-default sm:gap-gap-compact-default">
        <button type="button" class="inline-flex min-h-action-min-default items-center rounded-layout-radius-full-base px-inset-operator-default font-typography-family-mono-base text-typography-size-xs-base text-text-content-secondary-base transition-colors duration-transition-duration-fast-base ease-transition-easing-standard-base hover:bg-surface-background-tertiary-base hover:text-text-content-primary-base" data-theme-toggle aria-pressed="false" aria-label="Switch to light theme">Light theme</button>
        <a href="/chat" class="hidden min-h-action-min-default items-center gap-gap-compact-default rounded-layout-radius-full-base border border-surface-accent-brand-base bg-surface-background-tertiary-base px-rhythm-4-base font-typography-family-sans-base text-typography-size-sm-base font-typography-weight-medium-base text-text-content-primary-base transition-colors duration-transition-duration-fast-base ease-transition-easing-standard-base hover:bg-surface-background-secondary-base sm:inline-flex">Chat<span aria-hidden="true">→</span></a>
        <button type="button" class="inline-flex min-h-action-min-default items-center whitespace-nowrap rounded-layout-radius-full-base border border-border-separator-primary-base bg-surface-background-tertiary-base px-rhythm-3-base font-typography-family-mono-base text-typography-size-xs-base text-text-content-primary-base lg:hidden" data-menu-toggle aria-expanded="false" aria-controls="site-nav-sheet" aria-label="Menu">Menu</button>
      </div>
    </nav>
  </div>
</header>
