---
const { class: className = '' } = Astro.props;
---
<div aria-hidden="true" class={`flex w-layout-width-sidebar-base gap-gap-dense-default ${className}`}>
  <span class="h-indicator-fivebar-base flex-1 rounded-layout-radius-full-base bg-persona-accent-brand-base"></span>
  <span class="h-indicator-fivebar-base flex-1 rounded-layout-radius-full-base bg-persona-accent-family-a-base"></span>
  <span class="h-indicator-fivebar-base flex-1 rounded-layout-radius-full-base bg-persona-accent-family-b-base"></span>
  <span class="h-indicator-fivebar-base flex-1 rounded-layout-radius-full-base bg-persona-accent-family-c-base"></span>
  <span class="h-indicator-fivebar-base flex-1 rounded-layout-radius-full-base bg-persona-accent-family-d-base"></span>
</div>
