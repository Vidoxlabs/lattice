---
import { renderPipelineFlow } from '../../lib/diagrams/pipeline-flow.mjs';
import { monoLabelClasses, sectionHeadingClasses } from '../../lib/ui-classes.mjs';
const { pipeline, freshness } = Astro.props;
const { stages, rows } = renderPipelineFlow(pipeline, freshness);
---
<section aria-labelledby="pipeline-flow-heading" data-videsign="multi-step-stepper" class="flex flex-col gap-rhythm-6-base rounded-layout-radius-standard-base border border-border-separator-primary-base bg-surface-background-secondary-base p-layout-padding-large-base">
  <div class="flex flex-wrap items-end justify-between gap-gap-compact-default">
    <div class="flex flex-col gap-gap-dense-default">
      <p class={monoLabelClasses}>Verified content flow</p>
      <h2 id="pipeline-flow-heading" class={sectionHeadingClasses}>The self-updating pipeline</h2>
    </div>
    <p role="status" class={`${monoLabelClasses} tabular-nums`}>{freshness.freshCount} of {freshness.systemCount} system docs current</p>
  </div>
  <ol aria-label="Content pipeline stages" class="grid list-none grid-cols-1 gap-rhythm-6-base sm:grid-cols-2 lg:grid-cols-3">
    {stages.map((stage, index) => {
      const last = index === stages.length - 1;
      // The grid is one, two or three columns at base, sm and lg, so the
      // connector is only shown when another stage follows on the same row.
      const connector = last
        ? 'invisible'
        : [
          'invisible',
          (index + 1) % 2 === 0 ? 'sm:invisible' : 'sm:visible',
          (index + 1) % 3 === 0 ? 'lg:invisible' : 'lg:visible'
        ].join(' ');
      return (
        <li data-pipeline-stage={stage.id} class="flex min-w-0 flex-col gap-gap-comfortable-default">
          <div class="flex items-center gap-gap-compact-default">
            <span class="inline-flex h-indicator-brand-base w-indicator-brand-base shrink-0 items-center justify-center rounded-layout-radius-full-base border border-border-graph-line-base bg-surface-background-tertiary-base font-typography-family-mono-base text-typography-size-xs-base tabular-nums text-text-content-primary-base">{String(index + 1).padStart(2, '0')}</span>
            <span aria-hidden="true" class={`flex-1 border-t border-border-graph-line-base ${connector}`}></span>
          </div>
          <div class="flex min-w-0 flex-col gap-gap-dense-default">
            <h3 class="font-typography-family-sans-base text-typography-size-md-base font-typography-weight-semibold-base leading-typography-leading-tight-base text-balance text-text-content-primary-base">{stage.label}</h3>
            <p data-pipeline-caption class="font-typography-family-sans-base text-typography-size-sm-base leading-typography-leading-normal-base text-pretty text-text-content-secondary-base">{stage.state}</p>
          </div>
        </li>
      );
    })}
  </ol>
  <details class="border-t border-border-separator-primary-base pt-rhythm-3-base">
    <summary class="inline-flex min-h-action-min-default cursor-pointer items-center font-typography-family-mono-base text-typography-size-xs-base text-text-content-primary-base">Read the pipeline as a table</summary>
    <div class="mt-rhythm-3-base overflow-x-auto">
      <table class="w-full border-collapse text-start font-typography-family-sans-base text-typography-size-sm-base tabular-nums">
        <thead><tr><th scope="col" class="border-b border-border-separator-primary-base pb-rhythm-2-base pe-rhythm-4-base text-start font-typography-weight-medium-base text-text-content-secondary-base">Stage</th><th scope="col" class="border-b border-border-separator-primary-base pb-rhythm-2-base text-start font-typography-weight-medium-base text-text-content-secondary-base">State on this build</th></tr></thead>
        <tbody>{rows.map((row) => <tr><td class="border-b border-border-separator-primary-base py-rhythm-3-base pe-rhythm-4-base text-text-content-primary-base">{row.stage}</td><td class="border-b border-border-separator-primary-base py-rhythm-3-base text-text-content-secondary-base">{row.state}</td></tr>)}</tbody>
      </table>
    </div>
  </details>
</section>
